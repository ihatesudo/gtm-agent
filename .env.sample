# Recommended: OpenRouter is the model provider for this app.
# Create a restricted API key with a spending limit in the OpenRouter dashboard.
GENAI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Pin a lower-cost model here, or use OpenRouter's automatic model routing.
OPENROUTER_MODEL=openrouter/auto
# Optional, once the app is deployed.
OPENROUTER_SITE_URL=

# Appwrite Cloud Magic URL authentication. These two values are safe to expose
# to the browser. Never put an Appwrite API key in this file.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<project-id>

# Optional Gemini alternative (not used when GENAI_PROVIDER=openrouter)
# GEMINI_API_KEY=replace-me
