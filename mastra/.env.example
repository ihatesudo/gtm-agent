OPENROUTER_API_KEY=
# IMPORTANT: must be a concrete ":free" slug. "openrouter/auto" is a PAID
# router alias that burns credits. See OPENROUTER_FREE_MODELS in model.ts.
# Leave unset to use the default pinned free model.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Google AI Studio / Gemini API key (prepaid)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# To use your $300 GCP Trial Credits via Vertex AI instead of AI Studio:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS='{JSON}'

ZHIPU_API_KEY=

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


