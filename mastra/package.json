{
  "name": "gtm-agent-mastra",
  "version": "0.2.0",
  "private": true,
  "description": "GTM Agent — Mastra campaign orchestrator",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "test": "mastra build --studio && npm run ui:build && node .mastra/output/index.mjs",
    "ui:build": "mkdir -p .mastra/output/studio && (cd ui && npm run build) && cp -r ui/dist/* .mastra/output/studio/",
    "prd": "mastra build",
    "deploy": "mastra build && wrangler deploy",
    "postbuild": "npm run ui:build",
    "test:smoke": "node ui/scripts/smoke-test.mjs",
    "test:smoke:live": "MASTRA_URL=http://localhost:4111 node ui/scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/deployer-cloudflare": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "mastra": "latest",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
