# Recommended model provider: OpenRouter (OpenAI-compatible; choose a lower-cost
# model in OPENROUTER_MODEL instead of using Gemini directly).
PROVIDER=openrouter
GENAI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openrouter/auto
# Optional attribution after deployment; leave blank during local development.
OPENROUTER_SITE_URL=

# Alternative Gemini / Vertex AI configuration
# GENAI_PROVIDER=api
# GEMINI_API_KEY=replace-me
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Appwrite Cloud Magic URL auth. Both values are safe to expose to the browser;
# never add an Appwrite API key to this file or to Reflex Cloud's public config.
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<project-id>

# Hosting URLs. These are not secrets. Set them while running `make hosting-build`;
# set REFLEX_CORS_ALLOWED_ORIGINS on Render to the final Appwrite Sites URL.
# BACKEND_URL=https://your-api.onrender.com
# SITE_URL=https://your-site.appwrite.network

# Turso DB Configuration (used by Mastra storage)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=